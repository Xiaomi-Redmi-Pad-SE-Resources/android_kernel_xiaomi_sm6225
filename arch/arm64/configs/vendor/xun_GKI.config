# PMIC
CONFIG_BQ2589X_CHARGER=m
CONFIG_NOPMI_POWER_SUPPLY=m
CONFIG_QCOM_PMIC_VOTER=m
CONFIG_SH36610X_BATTERY=m

# Product
CONFIG_TARGET_PRODUCT_XUN=y

# QCOM
CONFIG_MFD_QCOM_RPM=m
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_CLK_RPM=m
CONFIG_QCOM_MICRODUMP=m
CONFIG_QCOM_MINIDUMP_LAST_KMSG=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m

# USB
CONFIG_SIMTRAY_STATUS=m
CONFIG_TYPEC_CLASS=y
CONFIG_USB_CONFIGFS_RNDIS=m
CONFIG_WUSB3801_DEBUG=m
